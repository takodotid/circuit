{
    "compilerOptions": {
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["bun"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@takodotid/circuit": ["./src/index.ts"],
            "@takodotid/circuit/presets": ["./src/presets/index.ts"]
        },
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src/**/*.ts", "src/cli/studio/public/*.js", "examples/**/*.ts", "templates/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
    "exclude": ["node_modules"]
}
