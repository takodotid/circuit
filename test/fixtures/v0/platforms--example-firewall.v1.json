{
  "name": "example-firewall",
  "site": "platforms",
  "platform": "fortios",
  "model": "FG-3700D",
  "connection": {
    "host": "192.0.2.4",
    "user": "netops"
  },
  "system": {
    "timezone": "Asia/Jakarta",
    "banner": "Authorised access only.",
    "ip_stack": {
      "icmp_redirects": true
    },
    "dns": {
      "servers": [
        "192.0.2.53",
        "2001:db8::53"
      ]
    },
    "ntp": {
      "servers": [
        "192.0.2.1",
        "pool.ntp.org"
      ]
    },
    "logging": {
      "local": {
        "level": "warning"
      }
    },
    "hardware_offload": true,
    "users": {
      "netops": {
        "role": "admin",
        "password": {
          "secret": "EXAMPLE_NETOPS_PASSWORD"
        },
        "description": "Network team",
        "ssh_keys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGq5UoWNbDBN7kXsEcNWmMEqlb7r0Ec6oOOfzxwKrUfS netops@example"
        ]
      },
      "noc": {
        "role": "operator",
        "password": {
          "secret": "EXAMPLE_NOC_PASSWORD"
        }
      },
      "monitor": {
        "role": "read-only",
        "password": {
          "secret": "EXAMPLE_MONITOR_PASSWORD"
        }
      }
    },
    "certificates": {
      "web": {
        "certificate_file": "platforms--example-firewall.web.pem",
        "private_key": {
          "secret": "EXAMPLE_WEB_KEY"
        }
      }
    }
  },
  "management": {
    "allow": [
      "192.0.2.0/24",
      "2001:db8::/64"
    ],
    "ssh": {
      "port": 2222,
      "auth_timeout": 30
    },
    "https": {
      "port": 8443,
      "certificate": "web"
    },
    "native_protocol": {}
  },
  "monitoring": {
    "snmp": {
      "allow": [
        "192.0.2.96/28"
      ],
      "community": {
        "secret": "EXAMPLE_SNMP_COMMUNITY"
      },
      "users": {
        "monitor": {
          "auth": "sha1",
          "auth_password": {
            "secret": "EXAMPLE_SNMP_AUTH"
          },
          "privacy": "aes128",
          "privacy_password": {
            "secret": "EXAMPLE_SNMP_PRIVACY"
          }
        }
      },
      "contact": "noc@example.com",
      "location": "Rack 2, Jakarta"
    },
    "syslog": [
      {
        "address": "192.0.2.98",
        "level": "info"
      },
      {
        "address": "192.0.2.99",
        "port": 5514,
        "level": "warning"
      }
    ],
    "flow_export": {
      "protocol": "sflow",
      "collectors": [
        {
          "address": "192.0.2.99"
        }
      ],
      "sampling": 4096,
      "interfaces": [
        "uplink",
        "servers"
      ]
    }
  },
  "interfaces": {
    "ethernet": {
      "40g-1": {
        "description": "Upstream bond",
        "speed": "40g",
        "in_lag": "uplink"
      },
      "40g-2": {
        "description": "Upstream bond",
        "speed": "40g",
        "in_lag": "uplink"
      },
      "10g-1": {
        "description": "Core switch",
        "trunk_vlans": [
          "management",
          "servers",
          "guests"
        ],
        "mtu": 9000
      },
      "10g-2": {
        "description": "Lab host",
        "speed": "1g",
        "lldp": false,
        "addresses": [
          "198.51.100.193/27"
        ],
        "ingress_acl": "lab"
      },
      "1g-1": {
        "description": "Out-of-band",
        "addresses": [
          "192.0.2.4/26"
        ]
      }
    },
    "lag": {
      "uplink": {
        "description": "Upstream",
        "mode": "lacp",
        "addresses": [
          "203.0.113.10/30",
          "2001:db8:fff0::2/64"
        ]
      }
    },
    "loopback": {
      "loopback": {
        "description": "Router address",
        "addresses": [
          "198.51.100.255/32"
        ]
      }
    },
    "vlan_interface": {
      "management": {
        "vlan": "management",
        "description": "Management",
        "vrrp": [
          {
            "id": 1,
            "address": "192.0.2.190",
            "priority": 200,
            "preempt": true
          }
        ],
        "addresses": [
          "192.0.2.129/26",
          "192.0.2.161/27",
          "2001:db8:10::1/64"
        ]
      },
      "servers": {
        "vlan": "servers",
        "mtu": 9000,
        "ipv6_ra": true,
        "addresses": [
          "198.51.100.33/27",
          "2001:db8:40::1/64",
          "2001:db8:41::1/64"
        ]
      },
      "guests": {
        "vlan": "guests",
        "vrf": "guests",
        "addresses": [
          "198.51.100.97/27"
        ]
      }
    },
    "gre": {
      "partner": {
        "description": "Partner tunnel",
        "addresses": [
          {
            "address": "192.0.2.249/30",
            "peer_address": "192.0.2.250"
          },
          "2001:db8:ffee::1/64"
        ],
        "local_address": "203.0.113.10",
        "remote_address": "203.0.113.220"
      }
    },
    "vxlan": {
      "stretch": {
        "vni": 5000,
        "mac": "02:00:00:00:50:00",
        "addresses": [
          "192.0.2.241/29"
        ],
        "local_address": "203.0.113.10",
        "remote_address": "203.0.113.221"
      }
    }
  },
  "switching": {
    "vlans": {
      "management": {
        "id": 10
      },
      "servers": {
        "id": 20
      },
      "guests": {
        "id": 30
      }
    },
    "lldp": true,
    "acls": {
      "lab": [
        {
          "description": "Drop spoofed",
          "if": {
            "src": "192.0.2.0/24"
          },
          "then": "drop"
        },
        {
          "description": "No memcached",
          "if": {
            "protocol": "udp",
            "dst_port": 11211
          },
          "then": "drop"
        },
        {
          "then": "accept"
        }
      ]
    }
  },
  "services": {
    "dhcp_server": {
      "servers": {
        "interface": "servers",
        "network": "198.51.100.32/27",
        "gateway": "198.51.100.33",
        "dns": [
          "192.0.2.53"
        ],
        "pool": [
          "198.51.100.40",
          "198.51.100.50"
        ],
        "lease_time": 3600,
        "reservations": [
          {
            "address": "198.51.100.41",
            "mac": "00:11:22:33:44:55",
            "description": "Printer"
          }
        ]
      }
    },
    "dhcp_relay": {
      "guests": {
        "interface": "guests",
        "servers": [
          "198.51.100.66"
        ]
      },
      "servers": {
        "interface": "servers",
        "servers": [
          "2001:db8::67"
        ]
      }
    },
    "dns_server": true,
    "ntp_server": true
  },
  "routing": {
    "router_id": "198.51.100.255",
    "bfd": {
      "interval": 300,
      "multiplier": 4
    },
    "vrfs": {
      "guests": {}
    },
    "static_routes": [
      {
        "prefix": "0.0.0.0/0",
        "description": "Upstream",
        "bfd": true,
        "next_hop": "203.0.113.9"
      },
      {
        "prefix": "::/0",
        "next_hop": "2001:db8:fff0::1"
      },
      {
        "prefix": "198.51.100.0/24",
        "blackhole": true,
        "description": "Originate"
      },
      {
        "prefix": "198.18.0.0/15",
        "distance": 20,
        "next_hop": "192.0.2.130"
      },
      {
        "prefix": "0.0.0.0/0",
        "vrf": "guests",
        "description": "Guest exit",
        "next_hop": "198.51.100.98"
      }
    ],
    "ospf": {
      "areas": {
        "0.0.0.0": {
          "interfaces": {
            "loopback": {
              "passive": true
            },
            "management": {
              "cost": 10,
              "network": "point-to-point",
              "bfd": true
            }
          }
        }
      },
      "redistribute": [
        "connected"
      ],
      "address_families": [
        "ipv4",
        "ipv6"
      ]
    },
    "bgp": {
      "asn": 64500,
      "originated_prefixes": [
        "198.51.100.0/24"
      ],
      "neighbor_groups": {
        "upstream": {
          "remote_as": 64501,
          "max_prefixes": 1000,
          "password": {
            "secret": "EXAMPLE_BGP_PASSWORD"
          },
          "bfd": true,
          "import_policy": "UPSTREAM-IN",
          "export_policy": "UPSTREAM-OUT"
        }
      },
      "neighbors": {
        "upstream-1": {
          "address": "203.0.113.9",
          "description": "Transit",
          "neighbor_group": "upstream"
        },
        "upstream-1-v6": {
          "address": "2001:db8:fff0::1",
          "neighbor_group": "upstream"
        },
        "internal": {
          "address": "192.0.2.130",
          "remote_as": 64500,
          "local_address": "198.51.100.255",
          "multihop": true,
          "passive": true,
          "hold_time": 90,
          "keepalive": 30
        }
      }
    },
    "policies": {
      "UPSTREAM-IN": [
        {
          "description": "Not too specific, and not marked to drop",
          "if": {
            "prefix_length": {
              "min": 25
            }
          },
          "then": "reject"
        },
        {
          "if": {
            "standard_community": "64501:666"
          },
          "then": "reject"
        },
        {
          "description": "Only the default route",
          "if": {
            "prefix": "0.0.0.0/0"
          },
          "set": {
            "local_pref": 200,
            "add_standard_communities": [
              "64500:100"
            ]
          },
          "then": "accept"
        },
        {
          "description": "The upstream's own",
          "if": {
            "prefix_set": "upstream-origins"
          },
          "set": {
            "med": 10
          },
          "then": "accept"
        }
      ],
      "UPSTREAM-OUT": [
        {
          "call": "NOT-TO-UPSTREAMS"
        },
        {
          "description": "Our space",
          "if": {
            "family": "ipv4",
            "prefix_set": "ours",
            "prefix_length": {
              "max": 24
            }
          },
          "set": {
            "prepend": 1,
            "next_hop": "203.0.113.10",
            "remove_standard_communities": [
              "64500:*"
            ]
          },
          "then": "accept"
        },
        {
          "description": "Tagged for upstreams",
          "if": {
            "family": "ipv6"
          },
          "set": {
            "standard_communities": [
              "64501:100"
            ]
          },
          "then": "accept"
        }
      ],
      "NOT-TO-UPSTREAMS": [
        {
          "if": {
            "standard_community": "64500:999"
          },
          "then": "reject"
        }
      ]
    },
    "prefix_sets": {
      "ours": {
        "prefixes": [
          "198.51.100.0/24"
        ]
      },
      "upstream-origins": {
        "source": {
          "registry": "ripe-stat",
          "query": "AS64501",
          "family": "ipv4"
        }
      }
    }
  },
  "firewall": {
    "address_sets": {
      "management": [
        "192.0.2.0/24",
        "2001:db8::/64"
      ],
      "dns": [
        "192.0.2.53"
      ],
      "partners": [
        "203.0.113.192/28"
      ]
    },
    "filter": {
      "input": {
        "default_action": "drop",
        "rules": [
          {
            "description": "Established",
            "if": {
              "connection_state": [
                "established",
                "related"
              ]
            },
            "then": "accept"
          },
          {
            "description": "Management",
            "if": {
              "src_address_set": "management"
            },
            "then": "accept"
          },
          {
            "description": "VRRP",
            "if": {
              "protocol": "vrrp",
              "in_interface": "management"
            },
            "then": "accept"
          },
          {
            "description": "OSPF",
            "if": {
              "protocol": "ospf"
            },
            "then": "accept"
          },
          {
            "description": "BGP",
            "if": {
              "protocol": "tcp",
              "dst_port": 179
            },
            "then": "accept"
          },
          {
            "description": "Ping",
            "if": {
              "protocol": "icmp"
            },
            "then": "accept"
          }
        ]
      },
      "forward": {
        "default_action": "drop",
        "rules": [
          {
            "description": "Established",
            "if": {
              "connection_state": [
                "established",
                "related"
              ]
            },
            "then": "accept",
            "fast_path": true
          },
          {
            "description": "Servers out",
            "if": {
              "in_interface": "servers",
              "out_interface": "uplink"
            },
            "then": "accept"
          },
          {
            "description": "Guests out",
            "if": {
              "src": "198.51.100.96/27",
              "out_interface": "uplink"
            },
            "then": "accept"
          },
          {
            "description": "Guests to resolvers",
            "if": {
              "protocol": "udp",
              "dst_port": 53,
              "dst_address_set": "dns"
            },
            "then": "accept"
          },
          {
            "description": "No SMTP out",
            "if": {
              "protocol": "tcp",
              "dst_port": [
                25,
                465,
                587
              ]
            },
            "then": "reject"
          },
          {
            "description": "Web in",
            "if": {
              "protocol": "tcp",
              "dst_port": 80,
              "dst": "198.51.100.42/32"
            },
            "then": "accept"
          }
        ]
      }
    },
    "nat": {
      "source": [
        {
          "description": "Guests out",
          "if": {
            "src": "198.51.100.96/27",
            "out_interface": "uplink"
          },
          "then": "masquerade"
        },
        {
          "description": "Servers out",
          "if": {
            "src": "198.51.100.32/27",
            "out_interface": "uplink"
          },
          "then": "snat",
          "to_address": "203.0.113.11"
        }
      ],
      "destination": [
        {
          "description": "Web server",
          "to_port": 80,
          "if": {
            "protocol": "tcp",
            "dst": "203.0.113.10/32",
            "dst_port": 8080,
            "in_interface": "uplink"
          },
          "then": "dnat",
          "to_address": "198.51.100.42"
        },
        {
          "description": "Mail for partners",
          "if": {
            "protocol": "tcp",
            "dst": "203.0.113.12/32",
            "dst_port": 25,
            "src_address_set": "partners"
          },
          "then": "dnat",
          "to_address": "198.51.100.43"
        }
      ]
    },
    "conntrack_helpers": [
      "ftp",
      "sip"
    ]
  }
}
