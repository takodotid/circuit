{
  "name": "example-router",
  "site": "platforms",
  "platform": "routeros",
  "model": "CCR2216-1G-12XS-2XQ",
  "connection": {
    "host": "192.0.2.1",
    "user": "admin"
  },
  "system": {
    "timezone": "Asia/Jakarta",
    "banner": "Authorised access only.",
    "release_channel": "long-term",
    "ip_stack": {
      "syn_cookies": true
    },
    "dns": {
      "servers": [
        "192.0.2.53"
      ]
    },
    "ntp": {
      "servers": [
        "pool.ntp.org"
      ]
    },
    "logging": {
      "local": {
        "level": "warning",
        "files": 5
      }
    },
    "hardware_offload": true,
    "users": {
      "admin": {
        "role": "admin",
        "password": {
          "secret": "EXAMPLE_ADMIN_PASSWORD"
        },
        "ssh_keys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyOnlyForTheExampleNotARealKey00000 operator"
        ]
      },
      "monitor": {
        "role": "read-only",
        "password": {
          "secret": "EXAMPLE_MONITOR_PASSWORD"
        }
      }
    },
    "certificates": {
      "web": {
        "certificate_file": "platforms--example-router.web.pem",
        "private_key": {
          "secret": "EXAMPLE_WEB_KEY"
        }
      }
    }
  },
  "management": {
    "allow": [
      "192.0.2.0/24"
    ],
    "ssh": {},
    "https": {
      "certificate": "web"
    },
    "native_protocol": {
      "interfaces": [
        "management"
      ]
    }
  },
  "monitoring": {
    "snmp": {
      "community": {
        "secret": "EXAMPLE_SNMP_COMMUNITY"
      },
      "users": {
        "monitor": {
          "auth": "sha1",
          "auth_password": {
            "secret": "EXAMPLE_SNMP_AUTH"
          },
          "privacy": "aes128",
          "privacy_password": {
            "secret": "EXAMPLE_SNMP_PRIVACY"
          }
        }
      },
      "location": "Rack 1"
    },
    "syslog": [
      {
        "address": "192.0.2.14",
        "port": 514,
        "level": "info"
      }
    ],
    "flow_export": {
      "protocol": "ipfix",
      "collectors": [
        {
          "address": "192.0.2.99"
        }
      ],
      "sampling": 100,
      "interfaces": [
        "uplink"
      ]
    }
  },
  "interfaces": {
    "ethernet": {
      "100g-1": {
        "description": "Core switch",
        "trunk_vlans": [
          "management",
          "servers",
          "guests"
        ],
        "lldp": true,
        "stp": {
          "cost": 100
        },
        "ingress_acl": "edge"
      },
      "25g-1": {
        "description": "Bond member",
        "in_lag": "uplink"
      },
      "25g-2": {
        "description": "Bond member",
        "in_lag": "uplink"
      },
      "25g-3": {
        "description": "Host",
        "access_vlan": "servers",
        "stp": {
          "edge": true
        },
        "storm_control": {
          "broadcast": {
            "percent": 5
          },
          "multicast": {
            "percent": 5
          }
        },
        "ethertypes": [
          "ipv4",
          "ipv6",
          "arp"
        ]
      },
      "25g-4": {
        "description": "Lab switch that must not join our spanning tree",
        "access_vlan": "guests",
        "stp": false
      },
      "25g-5": {
        "description": "A 10G optic in a 25G cage",
        "speed": "10g",
        "access_vlan": "guests"
      },
      "1g-1": {
        "description": "Out-of-band",
        "addresses": [
          "198.51.100.2/30"
        ]
      }
    },
    "lag": {
      "uplink": {
        "description": "Upstream bond",
        "mode": "lacp",
        "addresses": [
          "203.0.113.2/30"
        ]
      }
    },
    "loopback": {
      "loopback": {
        "addresses": [
          "192.0.2.255/32"
        ]
      }
    },
    "vlan_interface": {
      "management": {
        "vlan": "management",
        "vrrp": [
          {
            "id": 1,
            "address": "192.0.2.254",
            "priority": 200,
            "preempt": true
          }
        ],
        "addresses": [
          "192.0.2.1/24"
        ]
      },
      "servers": {
        "vlan": "servers",
        "ipv6_ra": true,
        "hardware_offload": false,
        "addresses": [
          "198.51.100.65/26",
          "2001:db8:20::1/64"
        ]
      },
      "guests": {
        "vlan": "guests",
        "vrf": "guests",
        "mac": "02:00:00:00:00:30",
        "addresses": [
          "198.51.100.129/26"
        ]
      }
    }
  },
  "switching": {
    "vlans": {
      "management": {
        "id": 10,
        "description": "Management"
      },
      "servers": {
        "id": 20
      },
      "guests": {
        "id": 30
      }
    },
    "stp": {
      "mode": "rstp",
      "priority": 4096
    },
    "lldp": {
      "interfaces": [
        "management"
      ]
    },
    "acls": {
      "edge": [
        {
          "description": "Drop spoofed",
          "if": {
            "src": "198.51.100.0/24"
          },
          "then": "drop"
        },
        {
          "description": "Cap UDP",
          "rate": "1G",
          "if": {
            "protocol": "udp"
          },
          "then": "accept"
        }
      ]
    }
  },
  "services": {
    "dhcp_server": {
      "servers": {
        "interface": "servers",
        "network": "198.51.100.64/26",
        "gateway": "198.51.100.65",
        "dns": [
          "192.0.2.53"
        ],
        "pool": [
          "198.51.100.100",
          "198.51.100.120"
        ],
        "lease_time": 3600
      }
    },
    "dhcp_relay": {
      "guests": {
        "interface": "guests",
        "servers": [
          "198.51.100.66"
        ]
      }
    },
    "dns_server": true,
    "ntp_server": true
  },
  "routing": {
    "router_id": "192.0.2.255",
    "rpki": [
      {
        "address": "192.0.2.80",
        "port": 323
      }
    ],
    "bfd": {
      "interval": 300,
      "multiplier": 4
    },
    "vrfs": {
      "guests": {
        "description": "Kept apart from everything else"
      }
    },
    "static_routes": [
      {
        "prefix": "0.0.0.0/0",
        "description": "Upstream",
        "next_hop": "203.0.113.1"
      },
      {
        "prefix": "198.51.100.0/24",
        "blackhole": true,
        "description": "Originate"
      },
      {
        "prefix": "0.0.0.0/0",
        "vrf": "guests",
        "description": "Guest exit",
        "next_hop": "198.51.100.130"
      }
    ],
    "ospf": {
      "areas": {
        "0.0.0.0": {
          "interfaces": {
            "management": {
              "passive": true
            },
            "uplink": {
              "cost": 10,
              "network": "point-to-point",
              "bfd": true
            }
          }
        }
      },
      "redistribute": [
        "connected",
        "static"
      ]
    },
    "bgp": {
      "asn": 64500,
      "originated_prefixes": [
        "198.51.100.0/24"
      ],
      "neighbor_groups": {
        "upstream": {
          "remote_as": 64501,
          "role": "provider",
          "max_prefixes": 10,
          "bfd": true,
          "import_policy": "UPSTREAM-IN",
          "export_policy": "UPSTREAM-OUT"
        }
      },
      "neighbors": {
        "upstream-1": {
          "address": "203.0.113.1",
          "neighbor_group": "upstream"
        },
        "internal": {
          "address": "192.0.2.254",
          "remote_as": 64500,
          "local_address": "192.0.2.255",
          "hold_time": 90,
          "keepalive": 30,
          "multihop": true,
          "bfd": true,
          "import_policy": "UPSTREAM-IN",
          "export_policy": "UPSTREAM-OUT"
        }
      }
    },
    "policies": {
      "UPSTREAM-IN": [
        {
          "description": "Blackhole",
          "if": {
            "large_community": "64500:666:0",
            "prefix_set": "ours"
          },
          "set": {
            "blackhole": true
          },
          "then": "accept"
        },
        {
          "description": "Only the default route",
          "if": {
            "prefix": "0.0.0.0/0"
          },
          "set": {
            "local_pref": 200,
            "preferred_source": "192.0.2.255",
            "add_large_communities": [
              "64500:1:1"
            ]
          },
          "then": "accept"
        },
        {
          "description": "The upstream's own customers",
          "if": {
            "as_path_length": {
              "min": 1,
              "max": 2
            }
          },
          "then": "accept"
        }
      ],
      "UPSTREAM-OUT": [
        {
          "description": "Not to upstreams",
          "if": {
            "large_community": "64500:100:0"
          },
          "then": "reject"
        },
        {
          "set": {
            "remove_large_communities": [
              "64500:*:*"
            ],
            "standard_communities": [
              "64501:100"
            ]
          }
        },
        {
          "description": "Our space",
          "if": {
            "prefix_set": "ours",
            "rpki": "valid"
          },
          "set": {
            "prepend": 1,
            "med": 10
          },
          "then": "accept"
        }
      ]
    },
    "prefix_sets": {
      "ours": {
        "prefixes": [
          "198.51.100.0/24"
        ]
      },
      "upstream-origins": {
        "source": {
          "registry": "ripe-stat",
          "query": "AS64501",
          "family": "ipv4"
        }
      }
    }
  },
  "firewall": {
    "address_sets": {
      "management": [
        "192.0.2.0/24"
      ]
    },
    "filter": {
      "input": {
        "default_action": "drop",
        "rules": [
          {
            "description": "Established",
            "if": {
              "connection_state": [
                "established",
                "related"
              ]
            },
            "then": "accept"
          },
          {
            "description": "Management",
            "if": {
              "src_address_set": "management"
            },
            "then": "accept"
          },
          {
            "description": "BGP",
            "if": {
              "protocol": "tcp",
              "dst_port": 179,
              "src": "203.0.113.1/32"
            },
            "then": "accept"
          },
          {
            "description": "OSPF",
            "if": {
              "protocol": "ospf"
            },
            "then": "accept"
          },
          {
            "description": "VRRP",
            "if": {
              "protocol": "vrrp"
            },
            "then": "accept"
          }
        ]
      },
      "forward": {
        "rules": [
          {
            "description": "Established",
            "if": {
              "connection_state": [
                "established",
                "related"
              ]
            },
            "then": "accept",
            "fast_path": true
          }
        ]
      }
    },
    "nat": {
      "source": [
        {
          "description": "Guests out",
          "if": {
            "src": "198.51.100.128/26",
            "out_interface": "uplink"
          },
          "then": "masquerade"
        }
      ],
      "destination": [
        {
          "description": "Web server",
          "to_port": 80,
          "if": {
            "protocol": "tcp",
            "dst_port": 8080,
            "in_interface": "uplink"
          },
          "then": "dnat",
          "to_address": "198.51.100.70"
        }
      ]
    },
    "conntrack_helpers": [
      "ftp"
    ]
  }
}
