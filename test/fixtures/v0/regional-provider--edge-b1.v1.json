    "filter": {
      "input": {
        "default_action": "drop",
        "rules": [
          {
            "description": "Replies",
            "if": {
              "connection_state": [
                "established",
                "related"
              ]
            },
            "then": "accept"
          },
          {
            "description": "Invalid",
            "if": {
              "connection_state": [
                "invalid"
              ]
            },
            "then": "drop"
          },
          {
            "description": "Ping",
            "if": {
              "protocol": "icmp"
            },
            "then": "accept"
          },
          {
            "description": "Management",
            "if": {
              "protocol": "tcp",
              "dst_port": [
                22,
                443,
                8729
              ],
              "src_address_set": "admin"
            },
            "then": "accept"
          },
          {
            "description": "SNMP",
            "if": {
              "protocol": "udp",
              "dst_port": 161,
              "src_address_set": "monitoring"
            },
            "then": "accept"
          },
          {
            "description": "BGP",
            "if": {
              "protocol": "tcp",
              "dst_port": 179,
              "src_address_set": "bgp-neighbors"
            },
            "then": "accept"
          },
          {
            "description": "BFD",
            "if": {
              "protocol": "udp",
              "dst_port": {
                "min": 3784,
                "max": 3785
              }
            },
            "then": "accept"
          },
          {
            "description": "OSPF",
            "if": {
              "protocol": "ospf"
            },
            "then": "accept"
          },
          {
            "description": "VRRP",
            "if": {
              "protocol": "vrrp"
            },
            "then": "accept"
          },
          {
            "description": "GRE",
            "if": {
              "protocol": "gre",
              "src_address_set": "tunnel-peers"
            },
            "then": "accept"
          },
          {
            "description": "VXLAN",
            "if": {
              "protocol": "udp",
              "dst_port": 4789,
              "src_address_set": "tunnel-peers"
            },
            "then": "accept"
          },
          {
            "description": "WireGuard",
            "if": {
              "protocol": "udp",
              "dst_port": [
                51820,
                51821
              ]
            },
            "then": "accept"
          },
          {
            "description": "DNS for customers, UDP",
            "if": {
              "protocol": "udp",
              "dst_port": 53,
              "src_address_set": "ours"
            },
            "then": "accept"
          },
          {
            "description": "DNS for customers, TCP",
            "if": {
              "protocol": "tcp",
              "dst_port": 53,
              "src_address_set": "ours"
            },
            "then": "accept"
          },
          {
            "description": "NTP for customers",
            "if": {
              "protocol": "udp",
              "dst_port": 123,
              "src_address_set": "ours"
            },
            "then": "accept"
          }
        ]
      },
      "forward": {
        "rules": [
          {
            "description": "Replies",
            "if": {
              "connection_state": [
                "established",
                "related"
              ]
            },
            "then": "accept",
            "fast_path": true
          },
          {
            "description": "Invalid",
            "if": {
              "connection_state": [
                "invalid"
              ]
            },
            "then": "drop"
          },
          {
            "description": "Bad flags FIN+SYN",
            "if": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "syn"
                ],
                "unset": []
              }
            },
            "then": "drop"
          },
          {
            "description": "Bad flags SYN+RST",
            "if": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "syn",
                  "rst"
                ],
                "unset": []
              }
            },
            "then": "drop"
          },
          {
            "description": "Bad flags FIN+RST",
            "if": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "rst"
                ],
                "unset": []
              }
            },
            "then": "drop"
          },
          {
            "description": "Bad flags FIN without ACK",
            "if": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin"
                ],
                "unset": [
                  "ack"
                ]
              }
            },
            "then": "drop"
          },
          {
            "description": "Bad flags FIN+URG",
            "if": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "urg"
                ],
                "unset": []
              }
            },
            "then": "drop"
          },
          {
            "description": "Bad flags Xmas scan",
            "if": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "syn",
                  "psh",
                  "urg"
                ],
                "unset": []
              }
            },
            "then": "drop"
          },
          {
            "description": "Remote desktop and telnet from transit-c",
            "if": {
              "protocol": "tcp",
              "dst_port": [
                23,
                3389,
                5900
              ],
              "in_interface": "transit-c"
            },
            "then": "drop"
          }
        ]
      }
    },
    "nat": {
      "source": [
        {
          "description": "Management out through transit-c",
          "if": {
            "src": "10.0.0.0/8",
            "out_interface": "transit-c"
          },
          "then": "masquerade"
        }
      ]
    },
    "conntrack_helpers": [
      "ftp"
    ]
  }
