{
  "name": "edge-01",
  "platform": "routeros",
  "model": "CCR2216-1G-12XS-2XQ",
  "connection": {
    "host": "10.0.0.1",
    "user": "operator"
  },
  "users": {
    "operator": {
      "role": "admin",
      "password": {
        "secret": "EDGE_01_PASSWORD"
      }
    }
  },
  "management": {
    "allow": [
      "10.0.0.0/24"
    ],
    "ssh": {}
  },
  "vlans": {
    "transit": {
      "id": 300,
      "description": "IP transit from Hurricane Electric, AS6939"
    },
    "ix": {
      "id": 200,
      "description": "Peering LAN of SGIX"
    },
    "acme": {
      "id": 1001,
      "description": "Acme, AS65550"
    }
  },
  "ports": {
    "1g-1": {
      "description": "Management",
      "addresses": [
        "10.0.0.1/24"
      ]
    },
    "25g-1": {
      "description": "Hurricane Electric",
      "access_vlan": "transit",
      "acl": "edge"
    },
    "25g-2": {
      "description": "SGIX",
      "access_vlan": "ix",
      "acl": "edge"
    },
    "25g-3": {
      "description": "Acme",
      "access_vlan": "acme"
    }
  },
  "interfaces": {
    "transit": {
      "type": "vlan",
      "vlan": "transit",
      "addresses": [
        "203.0.113.2/30"
      ]
    },
    "ix": {
      "type": "vlan",
      "vlan": "ix",
      "addresses": [
        "203.0.113.140/25",
        "2001:db8:ffff::70/64"
      ]
    },
    "acme": {
      "type": "vlan",
      "vlan": "acme",
      "addresses": [
        "198.51.100.253/30",
        "2001:db8:100:ff01::1/64"
      ]
    }
  },
  "routing": {
    "router_id": "203.0.113.2",
    "static": [
      {
        "prefix": "198.51.100.0/24",
        "blackhole": true,
        "description": "Originate"
      },
      {
        "prefix": "2001:db8:100::/48",
        "blackhole": true,
        "description": "Originate"
      }
    ],
    "bgp": {
      "asn": 64500,
      "networks": [
        "198.51.100.0/24",
        "2001:db8:100::/48"
      ],
      "neighbors": {
        "hurricane-electric": {
          "address": "203.0.113.1",
          "remote_as": 6939,
          "role": "provider",
          "import": "TRANSIT-IN",
          "export": "TRANSIT-OUT",
          "max_prefixes": 1200000
        },
        "sgix-rs": {
          "address": "203.0.113.129",
          "remote_as": 55518,
          "role": "rs",
          "import": "IX-IN",
          "export": "IX-OUT",
          "max_prefixes": 100000
        },
        "acme-v4": {
          "address": "198.51.100.254",
          "remote_as": 65550,
          "role": "customer",
          "import": "ACME-IN",
          "export": "ACME-OUT",
          "max_prefixes": 10
        },
        "acme-v6": {
          "address": "2001:db8:100:ff01::2",
          "remote_as": 65550,
          "role": "customer",
          "import": "ACME-IN",
          "export": "ACME-OUT",
          "max_prefixes": 10
        }
      }
    }
  },
  "prefix_sets": {
    "acme-v4": {
      "prefixes": [
        "192.0.2.0/24"
      ]
    },
    "acme-v6": {
      "prefixes": [
        "2001:db8:200::/48"
      ]
    }
  },
  "policies": {
    "SANITY": [
      {
        "description": "IPv4 shorter than /8",
        "match": {
          "family": "ipv4",
          "prefix_length": {
            "max": 7
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv4 longer than /24",
        "match": {
          "family": "ipv4",
          "prefix_length": {
            "min": 25
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv6 shorter than /16",
        "match": {
          "family": "ipv6",
          "prefix_length": {
            "max": 15
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv6 longer than /48",
        "match": {
          "family": "ipv6",
          "prefix_length": {
            "min": 49
          }
        },
        "action": "reject"
      },
      {
        "description": "RPKI invalid",
        "match": {
          "rpki": "invalid"
        },
        "action": "reject"
      }
    ],
    "TRANSIT-IN": [
      {
        "call": "SANITY"
      },
      {
        "description": "Learned from AS6939",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:*:*"
          ],
          "add_large_communities": [
            "64500:1:1",
            "64500:3:6939"
          ]
        }
      },
      {
        "set": {
          "local_pref": 100
        }
      },
      {
        "action": "accept"
      }
    ],
    "IX-IN": [
      {
        "call": "SANITY"
      },
      {
        "description": "Learned from AS55518",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:*:*"
          ],
          "add_large_communities": [
            "64500:1:2",
            "64500:3:55518"
          ]
        }
      },
      {
        "set": {
          "local_pref": 200
        }
      },
      {
        "action": "accept"
      }
    ],
    "ACME-IN": [
      {
        "description": "Blackhole, asked by the neighbor",
        "match": {
          "large_community": "64500:666:0",
          "prefix_set": "acme-v4"
        },
        "set": {
          "blackhole": true
        },
        "action": "accept"
      },
      {
        "description": "Blackhole, asked by the neighbor",
        "match": {
          "large_community": "64500:666:0",
          "prefix_set": "acme-v6"
        },
        "set": {
          "blackhole": true
        },
        "action": "accept"
      },
      {
        "call": "SANITY"
      },
      {
        "description": "Learned from AS65550",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:1:*",
            "64500:3:*"
          ],
          "add_large_communities": [
            "64500:1:3",
            "64500:3:65550"
          ]
        }
      },
      {
        "description": "Their IPv4",
        "match": {
          "prefix_set": "acme-v4"
        },
        "set": {
          "local_pref": 300
        },
        "action": "accept"
      },
      {
        "description": "Their IPv6",
        "match": {
          "prefix_set": "acme-v6"
        },
        "set": {
          "local_pref": 300
        },
        "action": "accept"
      },
      {
        "description": "Nothing else",
        "action": "reject"
      }
    ],
    "ACME-OUT": [
      {
        "description": "The full table",
        "action": "accept"
      }
    ],
    "TRANSIT-OUT": [
      {
        "description": "Blackholed here, never announced",
        "match": {
          "large_community": "64500:666:0"
        },
        "action": "reject"
      },
      {
        "description": "Asked not to be announced anywhere",
        "match": {
          "large_community": "64500:100:0"
        },
        "action": "reject"
      },
      {
        "description": "Asked not to be announced to AS6939",
        "match": {
          "large_community": "64500:100:6939"
        },
        "action": "reject"
      },
      {
        "description": "Asked to prepend once to AS6939",
        "match": {
          "large_community": "64500:101:6939"
        },
        "set": {
          "prepend": 1
        }
      },
      {
        "description": "Asked to prepend twice to AS6939",
        "match": {
          "large_community": "64500:102:6939"
        },
        "set": {
          "prepend": 2
        }
      },
      {
        "description": "Asked to prepend three times to AS6939",
        "match": {
          "large_community": "64500:103:6939"
        },
        "set": {
          "prepend": 3
        }
      },
      {
        "description": "Our communities stay inside our network",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:*:*"
          ]
        }
      },
      {
        "description": "Our IPv4",
        "match": {
          "prefix": "198.51.100.0/24"
        },
        "action": "accept"
      },
      {
        "description": "Our IPv6",
        "match": {
          "prefix": "2001:db8:100::/48"
        },
        "action": "accept"
      },
      {
        "description": "Customer IPv4",
        "match": {
          "prefix_set": "acme-v4"
        },
        "action": "accept"
      },
      {
        "description": "Customer IPv6",
        "match": {
          "prefix_set": "acme-v6"
        },
        "action": "accept"
      },
      {
        "description": "Nothing else leaves",
        "action": "reject"
      }
    ],
    "IX-OUT": [
      {
        "description": "Blackholed here, never announced",
        "match": {
          "large_community": "64500:666:0"
        },
        "action": "reject"
      },
      {
        "description": "Asked not to be announced anywhere",
        "match": {
          "large_community": "64500:100:0"
        },
        "action": "reject"
      },
      {
        "description": "Asked not to be announced to AS55518",
        "match": {
          "large_community": "64500:100:55518"
        },
        "action": "reject"
      },
      {
        "description": "Asked to prepend once to AS55518",
        "match": {
          "large_community": "64500:101:55518"
        },
        "set": {
          "prepend": 1
        }
      },
      {
        "description": "Asked to prepend twice to AS55518",
        "match": {
          "large_community": "64500:102:55518"
        },
        "set": {
          "prepend": 2
        }
      },
      {
        "description": "Asked to prepend three times to AS55518",
        "match": {
          "large_community": "64500:103:55518"
        },
        "set": {
          "prepend": 3
        }
      },
      {
        "description": "Our communities stay inside our network",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:*:*"
          ]
        }
      },
      {
        "description": "Our IPv4",
        "match": {
          "prefix": "198.51.100.0/24"
        },
        "action": "accept"
      },
      {
        "description": "Our IPv6",
        "match": {
          "prefix": "2001:db8:100::/48"
        },
        "action": "accept"
      },
      {
        "description": "Customer IPv4",
        "match": {
          "prefix_set": "acme-v4"
        },
        "action": "accept"
      },
      {
        "description": "Customer IPv6",
        "match": {
          "prefix_set": "acme-v6"
        },
        "action": "accept"
      },
      {
        "description": "Nothing else leaves",
        "action": "reject"
      }
    ]
  },
  "firewall": {
    "address_sets": {
      "bgp-neighbors": [
        "203.0.113.1",
        "203.0.113.129",
        "198.51.100.254",
        "2001:db8:100:ff01::2"
      ]
    },
    "filter": {
      "input": {
        "default": "drop",
        "rules": [
          {
            "description": "Replies",
            "match": {
              "state": [
                "established",
                "related"
              ]
            },
            "action": "accept"
          },
          {
            "description": "Ping",
            "match": {
              "protocol": "icmp"
            },
            "action": "accept"
          },
          {
            "description": "Management",
            "match": {
              "src": "10.0.0.0/24"
            },
            "action": "accept"
          },
          {
            "description": "BGP",
            "match": {
              "protocol": "tcp",
              "dst_port": 179,
              "src_set": "bgp-neighbors"
            },
            "action": "accept"
          }
        ]
      },
      "forward": {
        "rules": [
          {
            "description": "Bad flags FIN+SYN",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "syn"
                ],
                "unset": []
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags SYN+RST",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "syn",
                  "rst"
                ],
                "unset": []
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags FIN+RST",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "rst"
                ],
                "unset": []
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags FIN without ACK",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin"
                ],
                "unset": [
                  "ack"
                ]
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags FIN+URG",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "urg"
                ],
                "unset": []
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags Xmas scan",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "syn",
                  "psh",
                  "urg"
                ],
                "unset": []
              }
            },
            "action": "drop"
          }
        ]
      }
    }
  },
  "acls": {
    "edge": [
      {
        "description": "transit: drop source 198.51.100.0/24",
        "match": {
          "vlan": "transit",
          "src": "198.51.100.0/24"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 192.0.2.0/24",
        "match": {
          "vlan": "transit",
          "src": "192.0.2.0/24"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 127.0.0.0/8",
        "match": {
          "vlan": "transit",
          "src": "127.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 169.254.0.0/16",
        "match": {
          "vlan": "transit",
          "src": "169.254.0.0/16"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 0.0.0.0/8",
        "match": {
          "vlan": "transit",
          "src": "0.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 10.0.0.0/8",
        "match": {
          "vlan": "transit",
          "src": "10.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 172.16.0.0/12",
        "match": {
          "vlan": "transit",
          "src": "172.16.0.0/12"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 192.168.0.0/16",
        "match": {
          "vlan": "transit",
          "src": "192.168.0.0/16"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 198.51.100.0/24",
        "match": {
          "vlan": "ix",
          "src": "198.51.100.0/24"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 192.0.2.0/24",
        "match": {
          "vlan": "ix",
          "src": "192.0.2.0/24"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 127.0.0.0/8",
        "match": {
          "vlan": "ix",
          "src": "127.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 169.254.0.0/16",
        "match": {
          "vlan": "ix",
          "src": "169.254.0.0/16"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 0.0.0.0/8",
        "match": {
          "vlan": "ix",
          "src": "0.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 10.0.0.0/8",
        "match": {
          "vlan": "ix",
          "src": "10.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 172.16.0.0/12",
        "match": {
          "vlan": "ix",
          "src": "172.16.0.0/12"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 192.168.0.0/16",
        "match": {
          "vlan": "ix",
          "src": "192.168.0.0/16"
        },
        "action": "drop"
      }
    ]
  }
}
