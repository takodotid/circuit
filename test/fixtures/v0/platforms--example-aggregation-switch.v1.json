{
  "name": "example-aggregation-switch",
  "site": "platforms",
  "platform": "junos",
  "model": "QFX5100-48S-6Q",
  "connection": {
    "host": "203.0.113.130",
    "user": "netops"
  },
  "system": {
    "timezone": "Asia/Jakarta",
    "banner": "Authorized access only",
    "dns": {
      "servers": [
        "192.0.2.53"
      ]
    },
    "ntp": {
      "servers": [
        "192.0.2.1"
      ]
    },
    "logging": {
      "local": {
        "level": "notice",
        "files": 5
      }
    },
    "users": {
      "root": {
        "role": "admin",
        "password": {
          "secret": "EXAMPLE_ROOT_PASSWORD"
        }
      },
      "netops": {
        "role": "admin",
        "password": {
          "secret": "EXAMPLE_NETOPS_PASSWORD"
        },
        "description": "Network team",
        "ssh_keys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGq5UoWNbDBN7kXsEcNWmMEqlb7r0Ec6oOOfzxwKrUfS netops@example"
        ]
      },
      "monitor": {
        "role": "read-only",
        "password": {
          "secret": "EXAMPLE_MONITOR_PASSWORD"
        }
      }
    }
  },
  "management": {
    "allow": [
      "192.0.2.0/24",
      "2001:db8::/64"
    ],
    "ssh": {},
    "http": {},
    "api": {
      "port": 3443
    },
    "native_protocol": {}
  },
  "monitoring": {
    "snmp": {
      "community": {
        "secret": "EXAMPLE_SNMP_COMMUNITY"
      },
      "contact": "noc@example.com",
      "location": "Rack 4, Jakarta",
      "users": {
        "monitor": {
          "auth": "sha256",
          "auth_password": {
            "secret": "EXAMPLE_SNMP_AUTH"
          },
          "privacy": "aes128",
          "privacy_password": {
            "secret": "EXAMPLE_SNMP_PRIVACY"
          }
        }
      }
    },
    "syslog": [
      {
        "address": "192.0.2.98",
        "level": "info"
      }
    ],
    "flow_export": {
      "protocol": "sflow",
      "collectors": [
        {
          "address": "192.0.2.99"
        }
      ],
      "sampling": 4096,
      "interfaces": [
        "10g-1",
        "uplink"
      ]
    }
  },
  "interfaces": {
    "ethernet": {
      "1g-1": {
        "description": "Out-of-band",
        "addresses": [
          "203.0.113.130/26"
        ]
      },
      "40g-1": {
        "description": "Router",
        "in_lag": "uplink"
      },
      "40g-2": {
        "description": "Router",
        "in_lag": "uplink"
      },
      "10g-1": {
        "description": "Host",
        "access_vlan": "servers",
        "mtu": 9000,
        "stp": {
          "edge": true
        },
        "storm_control": {
          "broadcast": {
            "percent": 1
          },
          "multicast": {
            "percent": 1
          }
        },
        "ingress_acl": "host-in"
      },
      "10g-2": {
        "description": "Host on a 1G optic",
        "access_vlan": "servers",
        "speed": "1g",
        "lldp": false,
        "mac_limit": 1,
        "ethertypes": [
          "ipv4",
          "ipv6",
          "arp"
        ]
      },
      "10g-3": {
        "description": "Lab switch",
        "trunk_vlans": [
          "guests"
        ],
        "native_vlan": "native",
        "stp": false
      },
      "10g-48": {
        "description": "Transit",
        "addresses": [
          "198.51.100.5/31",
          "2001:db8:31::1/64"
        ],
        "ingress_acl": "transit-in"
      }
    },
    "lag": {
      "uplink": {
        "mode": "lacp",
        "trunk_vlans": [
          "management",
          "servers",
          "guests"
        ],
        "mtu": 9000,
        "stp": {
          "cost": 2000
        }
      }
    },
    "vlan_interface": {
      "management": {
        "vlan": "management",
        "description": "Management",
        "vrrp": [
          {
            "id": 1,
            "address": "192.0.2.254",
            "priority": 120,
            "preempt": true,
            "interval": 2
          }
        ],
        "mtu": 9000,
        "ipv6_ra": true,
        "addresses": [
          "192.0.2.5/24",
          "2001:db8::5/64"
        ]
      },
      "guests": {
        "vlan": "guests",
        "vrf": "guests",
        "addresses": [
          "198.51.100.131/26"
        ]
      }
    },
    "loopback": {
      "loopback": {
        "addresses": [
          "203.0.113.65/32",
          "2001:db8:ffff::1/128"
        ]
      }
    },
    "gre": {
      "tunnel": {
        "description": "To the far site",
        "mtu": 1476,
        "addresses": [
          "203.0.113.200/31"
        ],
        "local_address": "203.0.113.65",
        "remote_address": "198.51.100.200"
      }
    }
  },
  "switching": {
    "vlans": {
      "management": {
        "id": 10,
        "description": "Management"
      },
      "servers": {
        "id": 20
      },
      "guests": {
        "id": 30
      },
      "native": {
        "id": 999
      }
    },
    "stp": {
      "mode": "rstp",
      "priority": 8192
    },
    "lldp": true,
    "acls": {
      "host-in": [
        {
          "description": "SSH from admins",
          "if": {
            "protocol": "tcp",
            "src": "192.0.2.0/24",
            "dst_port": 22
          },
          "then": "accept"
        },
        {
          "description": "Traceroute",
          "rate": "10M",
          "if": {
            "protocol": "udp",
            "dst_port": {
              "min": 33434,
              "max": 33534
            }
          },
          "then": "accept"
        },
        {
          "description": "Ping",
          "if": {
            "protocol": "icmp"
          },
          "then": "accept"
        },
        {
          "description": "No IPv6 web",
          "if": {
            "family": "ipv6",
            "protocol": "tcp",
            "dst_port": [
              80,
              443
            ]
          },
          "then": "drop"
        }
      ],
      "transit-in": [
        {
          "description": "No spoofed sources",
          "if": {
            "src": "203.0.113.64/26"
          },
          "then": "drop"
        },
        {
          "description": "Limit ICMP",
          "rate": "2M",
          "if": {
            "protocol": "icmp"
          },
          "then": "accept"
        }
      ]
    }
  },
  "services": {
    "dhcp_server": {
      "management": {
        "interface": "management",
        "network": "192.0.2.0/24",
        "gateway": "192.0.2.254",
        "dns": [
          "192.0.2.53"
        ],
        "pool": [
          "192.0.2.100",
          "192.0.2.150"
        ],
        "lease_time": 86400,
        "reservations": [
          {
            "address": "192.0.2.101",
            "mac": "02:00:00:00:00:01",
            "description": "Console server"
          }
        ]
      }
    },
    "dhcp_relay": {
      "guests": {
        "interface": "guests",
        "servers": [
          "198.51.100.66"
        ]
      }
    }
  },
  "routing": {
    "router_id": "203.0.113.65",
    "rpki": [
      {
        "address": "192.0.2.80",
        "port": 323
      }
    ],
    "bfd": {
      "interval": 300,
      "multiplier": 4
    },
    "vrfs": {
      "guests": {
        "description": "Guest network"
      }
    },
    "static_routes": [
      {
        "prefix": "0.0.0.0/0",
        "next_hop": "192.0.2.1"
      },
      {
        "prefix": "0.0.0.0/0",
        "distance": 20,
        "next_hop": "198.51.100.4"
      },
      {
        "prefix": "203.0.113.64/26",
        "blackhole": true
      },
      {
        "prefix": "::/0",
        "bfd": true,
        "next_hop": "2001:db8::1"
      },
      {
        "prefix": "0.0.0.0/0",
        "vrf": "guests",
        "next_hop": "198.51.100.129"
      }
    ],
    "ospf": {
      "areas": {
        "0.0.0.0": {
          "interfaces": {
            "management": {
              "cost": 10,
              "bfd": true
            },
            "loopback": {
              "passive": true
            },
            "10g-48": {
              "network": "point-to-point"
            }
          }
        }
      },
      "redistribute": [
        "connected",
        "static"
      ],
      "address_families": [
        "ipv4",
        "ipv6"
      ]
    },
    "bgp": {
      "asn": 64500,
      "originated_prefixes": [
        "203.0.113.64/26"
      ],
      "neighbor_groups": {
        "transit": {
          "max_prefixes": 1000000,
          "hold_time": 90,
          "bfd": true,
          "import_policy": "transit-in",
          "export_policy": "transit-out"
        }
      },
      "neighbors": {
        "transit-1": {
          "address": "198.51.100.4",
          "remote_as": 64511,
          "description": "Transit",
          "password": {
            "secret": "EXAMPLE_BGP_PASSWORD"
          },
          "neighbor_group": "transit"
        },
        "customer-1": {
          "address": "192.0.2.30",
          "remote_as": 64512,
          "description": "Customer",
          "import_policy": "customer-in",
          "export_policy": "customer-out",
          "address_families": [
            "ipv4",
            "ipv6"
          ]
        },
        "collector-1": {
          "address": "192.0.2.90",
          "remote_as": 64500,
          "description": "Route collector",
          "local_address": "203.0.113.65",
          "multihop": true,
          "passive": true,
          "bfd": true
        }
      }
    },
    "policies": {
      "transit-in": [
        {
          "description": "Drop invalid",
          "if": {
            "rpki": "invalid"
          },
          "then": "reject"
        },
        {
          "description": "Drop long prefixes",
          "if": {
            "prefix_length": {
              "min": 25
            }
          },
          "then": "reject"
        },
        {
          "description": "Prefer short paths",
          "if": {
            "as_path_length": {
              "max": 3
            }
          },
          "set": {
            "local_pref": 120
          }
        },
        {
          "description": "Tag transit",
          "set": {
            "add_standard_communities": [
              "64500:100"
            ]
          },
          "then": "accept"
        }
      ],
      "transit-out": [
        {
          "call": "clean"
        },
        {
          "description": "Ours",
          "if": {
            "prefix_set": "ours"
          },
          "set": {
            "prepend": 2,
            "med": 10,
            "add_large_communities": [
              "64500:1:1"
            ]
          },
          "then": "accept"
        }
      ],
      "clean": [
        {
          "description": "Strip our tags",
          "set": {
            "remove_large_communities": [
              "64500:*:*"
            ],
            "remove_standard_communities": [
              "64500:*"
            ]
          }
        }
      ],
      "customer-in": [
        {
          "description": "Blackhole on request",
          "if": {
            "standard_community": "64500:666"
          },
          "set": {
            "blackhole": true
          },
          "then": "accept"
        },
        {
          "description": "Customer routes",
          "if": {
            "prefix_set": "customer"
          },
          "set": {
            "next_hop": "198.51.100.4",
            "standard_communities": [
              "64500:200"
            ]
          },
          "then": "accept"
        },
        {
          "description": "Customer IPv6",
          "if": {
            "family": "ipv6",
            "large_community": "64512:1:1"
          },
          "set": {
            "large_communities": [
              "64500:2:2"
            ]
          },
          "then": "accept"
        }
      ],
      "customer-out": [
        {
          "description": "Default only",
          "if": {
            "prefix": "0.0.0.0/0"
          },
          "then": "accept"
        }
      ]
    },
    "prefix_sets": {
      "ours": {
        "prefixes": [
          "203.0.113.64/26"
        ]
      },
      "customer": {
        "source": {
          "registry": "ripe-stat",
          "query": "AS64512",
          "family": "ipv4"
        }
      }
    }
  }
}
