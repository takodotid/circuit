  "policies": {
    "SANITY": [
      {
        "description": "IPv4 shorter than /8",
        "match": {
          "family": "ipv4",
          "prefix_length": {
            "max": 7
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv4 longer than /24",
        "match": {
          "family": "ipv4",
          "prefix_length": {
            "min": 25
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv6 shorter than /16",
        "match": {
          "family": "ipv6",
          "prefix_length": {
            "max": 15
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv6 longer than /48",
        "match": {
          "family": "ipv6",
          "prefix_length": {
            "min": 49
          }
        },
        "action": "reject"
      },
      {
        "description": "RPKI invalid",
        "match": {
          "rpki": "invalid"
        },
        "action": "reject"
      }
    ],
    "IBGP-IN": [
      {
        "description": "Everything our other edge routers pass on",
        "action": "accept"
      }
    ],
    "IBGP-OUT": [
      {
        "description": "Our IPv4",
        "match": {
          "prefix": "198.51.100.0/24"
        },
        "action": "accept"
      },
      {
        "description": "Our IPv6",
        "match": {
          "prefix": "2001:db8:100::/48"
        },
        "action": "accept"
      },
      {
        "description": "Learned from a transit",
        "match": {
          "large_community": "64500:1:1"
        },
        "action": "accept"
      },
      {
        "description": "Learned from a exchange",
        "match": {
          "large_community": "64500:1:2"
        },
        "action": "accept"
      },
      {
        "description": "Learned from a peer",
        "match": {
          "large_community": "64500:1:3"
        },
        "action": "accept"
      },
      {
        "description": "Learned from a customer",
        "match": {
          "large_community": "64500:1:4"
        },
        "action": "accept"
      },
      {
        "description": "Nothing untagged",
        "action": "reject"
      }
    ],
    "CUSTOMER-OUT": [
      {
        "description": "The full table",
        "action": "accept"
      }
    ],
    "TRANSIT-C-IN": [
      {
        "call": "SANITY"
      },
      {
        "description": "Learned from AS64503",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:*:*"
          ],
          "add_large_communities": [
            "64500:1:1",
            "64500:2:2",
            "64500:3:64503"
          ]
        }
      },
      {
        "set": {
          "local_pref": 100
        }
      },
      {
        "action": "accept"
      }
    ],
    "TRANSIT-C-OUT": [
      {
        "description": "Blackholed here, never announced",
        "match": {
          "large_community": "64500:666:0"
        },
        "action": "reject"
      },
      {
        "description": "Asked not to be announced anywhere",
        "match": {
          "large_community": "64500:100:0"
        },
        "action": "reject"
      },
      {
        "description": "Asked not to be announced to AS64503",
        "match": {
          "large_community": "64500:100:64503"
        },
        "action": "reject"
      },
      {
        "description": "Asked to prepend once to AS64503",
        "match": {
          "large_community": "64500:101:64503"
        },
        "set": {
          "prepend": 1
        }
      },
      {
        "description": "Asked to prepend twice to AS64503",
        "match": {
          "large_community": "64500:102:64503"
        },
        "set": {
          "prepend": 2
        }
      },
      {
        "description": "Asked to prepend three times to AS64503",
        "match": {
          "large_community": "64500:103:64503"
        },
        "set": {
          "prepend": 3
        }
      },
      {
        "description": "Our communities stay inside our network",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:*:*"
          ]
        }
      },
      {
