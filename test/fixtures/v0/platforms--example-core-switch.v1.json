{
  "name": "example-core-switch",
  "site": "platforms",
  "platform": "raisecom-ros",
  "model": "RAX721-C-6C48",
  "connection": {
    "host": "192.0.2.3",
    "user": "operator"
  },
  "system": {
    "timezone": "Asia/Jakarta",
    "ntp": {
      "servers": [
        "192.0.2.1"
      ]
    },
    "users": {
      "operator": {
        "role": "admin",
        "password": {
          "secret": "EXAMPLE_OPERATOR_PASSWORD"
        }
      }
    }
  },
  "management": {
    "allow": [
      "192.0.2.0/24"
    ],
    "ssh": {
      "auth_timeout": 100,
      "auth_retries": 3
    },
    "privilege_password": {
      "secret": "EXAMPLE_ENABLE"
    }
  },
  "monitoring": {
    "snmp": {
      "allow": [
        "192.0.2.10/32"
      ],
      "users": {
        "monitor": {
          "auth": "sha1",
          "auth_password": {
            "secret": "EXAMPLE_SNMP_AUTH"
          },
          "privacy": "aes128",
          "privacy_password": {
            "secret": "EXAMPLE_SNMP_PRIVACY"
          }
        }
      }
    },
    "syslog": [
      {
        "address": "192.0.2.50",
        "level": "info"
      }
    ],
    "transceivers": true
  },
  "interfaces": {
    "ethernet": {
      "100g-1": {
        "description": "Exchange",
        "access_vlan": "exchange",
        "lldp": false,
        "stp": false,
        "mac_limit": 1,
        "ethertypes": [
          "ipv4",
          "ipv6",
          "arp"
        ]
      },
      "25g-1": {
        "description": "Router",
        "in_lag": "router"
      },
      "25g-2": {
        "description": "Router",
        "in_lag": "router"
      },
      "10g-1": {
        "description": "Host",
        "access_vlan": "servers",
        "storm_control": {
          "broadcast": {
            "pps": 1000
          }
        }
      }
    },
    "lag": {
      "router": {
        "mode": "static",
        "trunk_vlans": [
          "management",
          "servers",
          "exchange"
        ],
        "native_vlan": "native"
      }
    },
    "vlan_interface": {
      "management": {
        "vlan": "management",
        "vrrp": [
          {
            "id": 1,
            "address": "192.0.2.254",
            "priority": 120,
            "interval": 2
          }
        ],
        "addresses": [
          "192.0.2.3/24"
        ]
      }
    }
  },
  "switching": {
    "vlans": {
      "management": {
        "id": 10
      },
      "servers": {
        "id": 20
      },
      "exchange": {
        "id": 200
      },
      "native": {
        "id": 999
      }
    },
    "stp": {
      "priority": 4096
    },
    "lldp": true
  },
  "routing": {
    "router_id": "192.0.2.3",
    "static_routes": [
      {
        "prefix": "0.0.0.0/0",
        "bfd": true,
        "next_hop": "192.0.2.1"
      }
    ],
    "ospf": {
      "areas": {
        "0.0.0.0": {
          "interfaces": {
            "management": {
              "cost": 10,
              "network": "point-to-point",
              "passive": true,
              "bfd": true
            }
          }
        }
      },
      "redistribute": [
        "connected",
        "static"
      ]
    }
  }
}
