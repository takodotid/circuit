{
  "name": "switch",
  "site": "single-site",
  "platform": "vrp",
  "model": "CE6855-48S6Q-HI",
  "connection": {
    "host": "192.168.10.2",
    "user": "operator"
  },
  "system": {
    "timezone": "Asia/Jakarta",
    "ntp": {
      "servers": [
        "192.168.10.1"
      ]
    },
    "users": {
      "operator": {
        "role": "admin",
        "password": {
          "secret": "SWITCH_PASSWORD"
        }
      }
    }
  },
  "management": {
    "allow": [
      "192.168.10.0/24"
    ],
    "ssh": {}
  },
  "interfaces": {
    "ethernet": {
      "10g-1": {
        "description": "Router",
        "trunk_vlans": [
          "mgmt",
          "home",
          "guests"
        ],
        "link": {
          "device": "router",
          "port": "25g-1"
        }
      },
      "10g-2": {
        "description": "Desk",
        "access_vlan": "home",
        "stp": {
          "edge": true
        }
      },
      "10g-3": {
        "description": "Living room",
        "access_vlan": "home",
        "stp": {
          "edge": true
        }
      },
      "10g-4": {
        "description": "Guest access point",
        "access_vlan": "guests",
        "stp": {
          "edge": true
        }
      }
    },
    "vlan_interface": {
      "mgmt": {
        "vlan": "mgmt",
        "addresses": [
          "192.168.10.2/24"
        ]
      }
    }
  },
  "switching": {
    "vlans": {
      "mgmt": {
        "id": 10,
        "description": "Management"
      },
      "home": {
        "id": 20,
        "description": "Home"
      },
      "guests": {
        "id": 30,
        "description": "Guests"
      }
    },
    "stp": {},
    "lldp": true
  },
  "routing": {
    "static_routes": [
      {
        "prefix": "0.0.0.0/0",
        "next_hop": "192.168.10.1"
      }
    ]
  }
}
