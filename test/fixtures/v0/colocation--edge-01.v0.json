{
  "name": "edge-01",
  "platform": "routeros",
  "model": "CCR2216-1G-12XS-2XQ",
  "connection": {
    "host": "10.0.0.1",
    "user": "operator"
  },
  "users": {
    "operator": {
      "role": "admin",
      "password": {
        "secret": "EDGE_01_PASSWORD"
      }
    }
  },
  "system": {
    "timezone": "Asia/Jakarta",
    "ntp": {
      "servers": [
        "pool.ntp.org"
      ]
    }
  },
  "management": {
    "allow": [
      "10.0.0.0/24"
    ],
    "ssh": {}
  },
  "vlans": {
    "mgmt": {
      "id": 99,
      "description": "Management of the switches"
    },
    "transit": {
      "id": 300,
      "description": "IP transit from Hurricane Electric, AS6939"
    },
    "ix": {
      "id": 200,
      "description": "Peering LAN of SGIX"
    },
    "acme-internet": {
      "id": 1001,
      "description": "Tenant acme internet"
    }
  },
  "ports": {
    "1g-1": {
      "description": "Management",
      "addresses": [
        "10.0.0.1/24"
      ]
    },
    "25g-1": {
      "description": "Hurricane Electric",
      "access_vlan": "transit",
      "acl": "edge"
    },
    "25g-2": {
      "description": "SGIX",
      "access_vlan": "ix",
      "acl": "edge"
    },
    "100g-1": {
      "description": "tor-01",
      "speed": "40g",
      "trunk_vlans": [
        "mgmt",
        "acme-internet"
      ],
      "link": {
        "device": "tor-01",
        "port": "40g-1"
      }
    }
  },
  "interfaces": {
    "mgmt": {
      "type": "vlan",
      "vlan": "mgmt",
      "addresses": [
        "10.0.99.1/24"
      ]
    },
    "transit": {
      "type": "vlan",
      "vlan": "transit",
      "addresses": [
        "203.0.113.2/30"
      ]
    },
    "ix": {
      "type": "vlan",
      "vlan": "ix",
      "addresses": [
        "192.0.2.10/24",
        "2001:db8:ffff::10/64"
      ]
    },
    "acme-internet": {
      "type": "vlan",
      "vlan": "acme-internet",
      "description": "Tenant acme",
      "addresses": [
        "198.51.100.9/29",
        "2001:db8:100:1::1/64"
      ]
    }
  },
  "routing": {
    "router_id": "203.0.113.2",
    "static": [
      {
        "prefix": "198.51.100.0/24",
        "blackhole": true,
        "description": "Originate"
      },
      {
        "prefix": "2001:db8:100::/48",
        "blackhole": true,
        "description": "Originate"
      }
    ],
    "bgp": {
      "asn": 64500,
      "networks": [
        "198.51.100.0/24",
        "2001:db8:100::/48"
      ],
      "neighbors": {
        "hurricane-electric": {
          "address": "203.0.113.1",
          "remote_as": 6939,
          "role": "provider",
          "import": "TRANSIT-IN",
          "export": "OUT",
          "max_prefixes": 1200000
        },
        "sgix-rs-v4": {
          "address": "192.0.2.1",
          "remote_as": 55518,
          "role": "rs",
          "import": "IX-IN",
          "export": "OUT",
          "max_prefixes": 100000
        },
        "sgix-rs-v6": {
          "address": "2001:db8:ffff::1",
          "remote_as": 55518,
          "role": "rs",
          "import": "IX-IN",
          "export": "OUT",
          "max_prefixes": 50000
        }
      }
    }
  },
  "policies": {
    "SANITY": [
      {
        "description": "IPv4 shorter than /8",
        "match": {
          "family": "ipv4",
          "prefix_length": {
            "max": 7
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv4 longer than /24",
        "match": {
          "family": "ipv4",
          "prefix_length": {
            "min": 25
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv6 shorter than /16",
        "match": {
          "family": "ipv6",
          "prefix_length": {
            "max": 15
          }
        },
        "action": "reject"
      },
      {
        "description": "IPv6 longer than /48",
        "match": {
          "family": "ipv6",
          "prefix_length": {
            "min": 49
          }
        },
        "action": "reject"
      },
      {
        "description": "RPKI invalid",
        "match": {
          "rpki": "invalid"
        },
        "action": "reject"
      }
    ],
    "TRANSIT-IN": [
      {
        "call": "SANITY"
      },
      {
        "description": "Learned from AS6939",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:*:*"
          ],
          "add_large_communities": [
            "64500:1:1",
            "64500:3:6939"
          ]
        }
      },
      {
        "set": {
          "local_pref": 100
        }
      },
      {
        "action": "accept"
      }
    ],
    "IX-IN": [
      {
        "call": "SANITY"
      },
      {
        "description": "Learned from AS55518",
        "set": {
          "remove_communities": [
            "64500:*"
          ],
          "remove_large_communities": [
            "64500:*:*"
          ],
          "add_large_communities": [
            "64500:1:2",
            "64500:3:55518"
          ]
        }
      },
      {
        "set": {
          "local_pref": 200
        }
      },
      {
        "action": "accept"
      }
    ],
    "OUT": [
      {
        "description": "Announce 198.51.100.0/24",
        "match": {
          "prefix": "198.51.100.0/24"
        },
        "action": "accept"
      },
      {
        "description": "Announce 2001:db8:100::/48",
        "match": {
          "prefix": "2001:db8:100::/48"
        },
        "action": "accept"
      },
      {
        "description": "Nothing else leaves",
        "action": "reject"
      }
    ]
  },
  "firewall": {
    "address_sets": {
      "bgp-neighbors": [
        "203.0.113.1",
        "192.0.2.1",
        "2001:db8:ffff::1"
      ]
    },
    "filter": {
      "input": {
        "default": "drop",
        "rules": [
          {
            "description": "Replies",
            "match": {
              "state": [
                "established",
                "related"
              ]
            },
            "action": "accept"
          },
          {
            "description": "Ping",
            "match": {
              "protocol": "icmp"
            },
            "action": "accept"
          },
          {
            "description": "Management",
            "match": {
              "src": "10.0.0.0/24"
            },
            "action": "accept"
          },
          {
            "description": "BGP",
            "match": {
              "protocol": "tcp",
              "dst_port": 179,
              "src_set": "bgp-neighbors"
            },
            "action": "accept"
          }
        ]
      },
      "forward": {
        "rules": [
          {
            "description": "Bad flags FIN+SYN",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "syn"
                ],
                "unset": []
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags SYN+RST",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "syn",
                  "rst"
                ],
                "unset": []
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags FIN+RST",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "rst"
                ],
                "unset": []
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags FIN without ACK",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin"
                ],
                "unset": [
                  "ack"
                ]
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags FIN+URG",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "urg"
                ],
                "unset": []
              }
            },
            "action": "drop"
          },
          {
            "description": "Bad flags Xmas scan",
            "match": {
              "protocol": "tcp",
              "tcp_flags": {
                "set": [
                  "fin",
                  "syn",
                  "psh",
                  "urg"
                ],
                "unset": []
              }
            },
            "action": "drop"
          }
        ]
      }
    }
  },
  "acls": {
    "edge": [
      {
        "description": "transit: drop source 198.51.100.0/24",
        "match": {
          "vlan": "transit",
          "src": "198.51.100.0/24"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 127.0.0.0/8",
        "match": {
          "vlan": "transit",
          "src": "127.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 169.254.0.0/16",
        "match": {
          "vlan": "transit",
          "src": "169.254.0.0/16"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 0.0.0.0/8",
        "match": {
          "vlan": "transit",
          "src": "0.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 10.0.0.0/8",
        "match": {
          "vlan": "transit",
          "src": "10.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 172.16.0.0/12",
        "match": {
          "vlan": "transit",
          "src": "172.16.0.0/12"
        },
        "action": "drop"
      },
      {
        "description": "transit: drop source 192.168.0.0/16",
        "match": {
          "vlan": "transit",
          "src": "192.168.0.0/16"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 198.51.100.0/24",
        "match": {
          "vlan": "ix",
          "src": "198.51.100.0/24"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 127.0.0.0/8",
        "match": {
          "vlan": "ix",
          "src": "127.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 169.254.0.0/16",
        "match": {
          "vlan": "ix",
          "src": "169.254.0.0/16"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 0.0.0.0/8",
        "match": {
          "vlan": "ix",
          "src": "0.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 10.0.0.0/8",
        "match": {
          "vlan": "ix",
          "src": "10.0.0.0/8"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 172.16.0.0/12",
        "match": {
          "vlan": "ix",
          "src": "172.16.0.0/12"
        },
        "action": "drop"
      },
      {
        "description": "ix: drop source 192.168.0.0/16",
        "match": {
          "vlan": "ix",
          "src": "192.168.0.0/16"
        },
        "action": "drop"
      },
      {
        "description": "transit: UDP to acme above 1G",
        "match": {
          "protocol": "udp",
          "vlan": "transit",
          "dst": "198.51.100.8/29"
        },
        "action": "accept",
        "rate": "1G"
      },
      {
        "description": "ix: UDP to acme above 1G",
        "match": {
          "protocol": "udp",
          "vlan": "ix",
          "dst": "198.51.100.8/29"
        },
        "action": "accept",
        "rate": "1G"
      }
    ]
  }
}
