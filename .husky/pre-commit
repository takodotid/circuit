# Every commit is linted and formatted. The typecheck runs unless the commit only changes Markdown. The tests run unless it only changes the website or Markdown, which they don't read.
bun run lint
bun run format:check
if git diff --cached --name-only | grep -qvE '\.md$'; then
    bun run typecheck
fi
if git diff --cached --name-only | grep -qvE '^docs/|\.md$'; then
    bun run test
fi
