# Every commit is linted and formatted. Typecheck and tests run, except when the commit only changes the website or Markdown: then only the check of the website's code samples runs.
bun run lint
bun run format:check
if git diff --cached --name-only | grep -qvE '^docs/|\.md$'; then
    bun run typecheck
    bun run test
else
    bun run editor-types && bun test test/docs.test.ts
fi
