{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "import", "vue"],
    "categories": {
        "correctness": "error",
        "suspicious": "error"
    },
    "options": {
        "typeAware": true,
        "denyWarnings": true,
        "reportUnusedDisableDirectives": "error"
    },
    "rules": {
        "typescript/no-deprecated": "error",

        // AGENTS.md rules, so no one has to remember them.
        "eslint/no-warning-comments": "error", // Planned work is a GitHub issue.
        "eslint/class-methods-use-this": ["error", { "ignoreOverrideMethods": true }], // A helper without state is static.
        "eslint/max-depth": "error", // Code is read top to bottom.
        "eslint/max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }], // A file does one job.
        "eslint/no-multi-assign": "error", // One step per line.
        "eslint/no-magic-numbers": [
            "error",
            {
                "ignore": [-1, 0, 0.5, 1, 2],
                "ignoreArrayIndexes": true,
                "ignoreDefaultValues": true,
                "ignoreEnums": true,
                "ignoreNumericLiteralTypes": true,
                "ignoreReadonlyClassProperties": true,
                "ignoreTypeIndexes": true
            }
        ],

        // One way to write each thing.
        "eslint/capitalized-comments": ["error", "always", { "ignorePattern": "\\S*[-_.\\d]", "ignoreConsecutiveComments": true }], // A name such as dc-1 keeps its case.
        "eslint/prefer-template": "error",
        "unicorn/numeric-separators-style": ["error", { "onlyIfContainsSeparator": true }], // An ASN or a port is written out: 64500.
        "unicorn/catch-error-name": "error",
        "unicorn/consistent-existence-index-check": "error",
        "unicorn/no-useless-undefined": ["error", { "checkArguments": false, "checkArrowFunctionBody": false }],
        "import/consistent-type-specifier-style": "error",
        "import/no-duplicates": "error",
        "import/no-cycle": "error",
        "typescript/consistent-type-imports": "error",
        "typescript/consistent-indexed-object-style": "error",
        "typescript/consistent-type-definitions": ["error", "type"],
        "typescript/switch-exhaustiveness-check": "error",

        // Circuit's style: classes with static methods, `{ if, then }` rules, and casts where TypeScript can't see the type.
        "typescript/no-extraneous-class": "off",
        "unicorn/no-thenable": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/unbound-method": "off",

        // Wrong here: a cast that stops a literal widening, a function that ends in `Ui.fail()`, a copy taken before changing a map.
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/consistent-return": "off",
        "unicorn/no-useless-spread": "off",

        // Taste, not bugs.
        "unicorn/consistent-function-scoping": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/no-array-reverse": "off",
        "eslint/no-shadow": "off",
        "eslint/no-new": "off",
        "eslint/no-control-regex": "off",
        "typescript/no-unnecessary-type-arguments": "off",
        "typescript/no-unnecessary-type-parameters": "off",
        "typescript/no-generated-empty-object-type": "off",
        "import/no-unassigned-import": "off",
        "unicorn/require-module-specifiers": "off",
        "eslint/no-underscore-dangle": "off"
    },
    "overrides": [
        {
            // Bun's types say `expect().rejects` returns nothing, but it returns a promise. Mocks turn their input into text.
            "files": ["test/**"],
            "rules": {
                "typescript/await-thenable": "off",
                "typescript/no-base-to-string": "off",
                "typescript/restrict-template-expressions": "off"
            }
        },
        {
            // A number in the language, a vendor's syntax, a test, or an example is the value itself: a port, a limit, a fixture.
            "files": ["src/config/**", "src/platforms/*/*.ts", "test/**", "examples/**"],
            "rules": { "eslint/no-magic-numbers": "off" }
        },
        {
            // A drawing's numbers are read as they are, as in CSS: positions, sizes, and the curve of a motion. A lesson's widget also shows the values it teaches.
            "files": [
                "docs/.vitepress/theme/academy/widgets/**",
                "docs/.vitepress/theme/home/home-drawing.ts",
                "src/studio/app/src/lib/graph-glide.ts",
                "src/studio/app/src/lib/graph-look.ts",
                "src/studio/app/src/lib/graph-svg.ts"
            ],
            "rules": { "eslint/no-magic-numbers": "off" }
        },
        {
            // Vue's rule asks a computed property to return a value on every path, so one writes `return undefined`.
            "files": ["**/*.vue"],
            "rules": { "unicorn/no-useless-undefined": "off" }
        },
        {
            // How a platform talks to a device: its waits and retries are named.
            "files": ["src/platforms/*/index.ts"],
            "rules": {
                "eslint/no-magic-numbers": [
                    "error",
                    {
                        "ignore": [-1, 0, 0.5, 1, 2],
                        "ignoreArrayIndexes": true,
                        "ignoreDefaultValues": true,
                        "ignoreEnums": true,
                        "ignoreNumericLiteralTypes": true,
                        "ignoreReadonlyClassProperties": true,
                        "ignoreTypeIndexes": true
                    }
                ]
            }
        },
        {
            // The editor shows the language's types on hover, so they keep the form a person reads: `{ readonly [K in Name]?: P }`.
            "files": ["src/config/**"],
            "rules": { "typescript/consistent-indexed-object-style": "off" }
        },
        {
            // Vue's global components are typed by adding to its `GlobalComponents` interface, which a type can't do.
            "files": ["docs/.vitepress/theme/index.ts"],
            "rules": { "typescript/consistent-type-definitions": "off" }
        },
        {
            // A project never needs a cast. If it does, the language has a bug.
            "files": ["examples/**"],
            "rules": {
                "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
                "typescript/no-non-null-assertion": "error"
            }
        }
    ],
    "ignorePatterns": [
        "test/fixtures/**",
        "**/*.generated.ts",
        ".claude/worktrees/**",
        "docs/.vitepress/cache/**",
        "docs/.vitepress/dist/**"
    ]
}
