{
    "name": "@takodotid/circuit",
    "version": "1.1.0",
    "description": "Declarative, vendor-neutral network configuration: describe each device in TypeScript, and Circuit makes the device match. One binary, nothing to install.",
    "homepage": "https://circuit.tako.id",
    "bugs": {
        "url": "https://github.com/takodotid/circuit/issues",
        "email": "noc@tako.id"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/takodotid/circuit.git"
    },
    "license": "BUSL-1.1",
    "author": {
        "name": "Tako Network Engineering Team",
        "email": "noc@tako.id",
        "url": "https://tako.id"
    },
    "contributors": [
        {
            "name": "Rafly Maulana",
            "email": "rafly@tako.id",
            "url": "https://raflymaulana.com"
        },
        {
            "name": "hzmi",
            "email": "hzmi@tako.id",
            "url": "https://hzmi.xyz"
        }
    ],
    "type": "module",
    "bin": {
        "circuit": "src/cli/index.ts"
    },
    "files": [
        "src",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "typecheck": "bun run editor-types && bunx tsc --noEmit && bunx tsc --noEmit -p src/studio/app",
        "test": "bun run editor-types && bun test",
        "build": "bun scripts/build.ts",
        "studio": "bun scripts/studio.ts",
        "editor-types": "bun scripts/editor-types.ts",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "docs:dev": "bun install --cwd docs && bun run --cwd docs dev",
        "docs:build": "bun install --cwd docs --frozen-lockfile && bun run --cwd docs build",
        "docs:preview": "bun run --cwd docs preview",
        "check": "bun run studio && bun run typecheck && bun run test && bun run format:check && bun run build",
        "prepare": "bun run studio; bun run editor-types; husky || true"
    },
    "dependencies": {
        "@clack/prompts": "1.8.1",
        "@commander-js/extra-typings": "~15.0.0",
        "commander": "~15.0.0",
        "prettier": "3.9.10",
        "ssh2": "^1.17.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@noble/ciphers": "1.3.0",
        "@noble/hashes": "1.8.0",
        "@types/bun": "^1.4.4",
        "@types/node": "^24.19.2",
        "@types/ssh2": "^1.15.6",
        "@vitejs/plugin-vue": "6.0.10",
        "cytoscape": "3.34.4",
        "husky": "^9.1.7",
        "typescript": "^7.0.2",
        "typescript-6": "npm:typescript@6.0.3",
        "vite": "8.3.5",
        "vue": "3.5.44"
    },
    "packageManager": "bun@1.4.4"
}
