{
    "name": "@takodotid/circuit",
    "version": "0.43.0",
    "description": "Declarative, vendor-neutral network configuration: describe each device in TypeScript, and Circuit makes the device match. Alpha.",
    "keywords": [
        "network",
        "network-automation",
        "infrastructure-as-code",
        "declarative",
        "netops",
        "bgp",
        "routeros",
        "mikrotik",
        "vrp",
        "huawei",
        "raisecom",
        "junos",
        "juniper",
        "fortios",
        "fortinet",
        "fortigate"
    ],
    "homepage": "https://circuit.tako.id",
    "bugs": {
        "url": "https://github.com/takodotid/circuit/issues",
        "email": "noc@tako.id"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/takodotid/circuit.git"
    },
    "license": "BUSL-1.1",
    "author": {
        "name": "Tako Network Engineering Team",
        "email": "noc@tako.id",
        "url": "https://tako.id"
    },
    "contributors": [
        {
            "name": "Rafly Maulana",
            "email": "rafly@tako.id",
            "url": "https://raflymaulana.com"
        },
        {
            "name": "hzmi",
            "email": "hzmi@tako.id",
            "url": "https://hzmi.xyz"
        }
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "bun": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./helpers": {
            "types": "./dist/types/helpers/index.d.ts",
            "bun": "./src/helpers/index.ts",
            "default": "./dist/helpers/index.js"
        }
    },
    "bin": {
        "circuit": "dist/cli/index.js"
    },
    "files": [
        "src",
        "dist",
        "templates",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": ">=22.12",
        "bun": ">=1.3.5"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "typecheck": "bunx tsc --noEmit",
        "test": "bun test",
        "build": "bun scripts/build.ts",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "docs:dev": "bun scripts/schema-reference.ts && vitepress dev docs",
        "docs:build": "bun scripts/schema-reference.ts && vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "release": "bun scripts/release.ts",
        "prepare": "husky || true",
        "prepack": "bun run build",
        "check": "bun run typecheck && bun run test && bun run format:check && bun run docs:build && bun run build && bunx tsc -p test/package && node dist/cli/index.js validate --config templates/single-site/circuit.config.ts && node dist/cli/index.js validate --config templates/edge-router/circuit.config.ts && node dist/cli/index.js validate --config templates/colocation/circuit.config.ts",
        "agents:setup": "npx -y skills experimental_install"
    },
    "dependencies": {
        "@clack/prompts": "^1.8.1",
        "@commander-js/extra-typings": "~15.0.0",
        "@types/ssh2": "^1.15.6",
        "commander": "~15.0.0",
        "jiti": "^2.7.0",
        "ssh2": "^1.17.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@types/bun": "^1.4.4",
        "@types/node": "^24.19.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vitepress": "^1.6.4"
    },
    "packageManager": "bun@1.4.4"
}
