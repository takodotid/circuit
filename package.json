{
    "name": "@takodotid/circuit",
    "version": "0.15.0",
    "description": "Declarative, vendor-neutral network configuration: describe each device in TypeScript, and Circuit makes the device match. Alpha.",
    "keywords": [
        "network",
        "network-automation",
        "infrastructure-as-code",
        "declarative",
        "netops",
        "bgp",
        "routeros",
        "mikrotik",
        "vrp",
        "huawei",
        "raisecom"
    ],
    "homepage": "https://circuit.tako.id",
    "bugs": {
        "url": "https://github.com/takodotid/circuit/issues",
        "email": "noc@tako.id"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/takodotid/circuit.git"
    },
    "license": "BUSL-1.1",
    "author": {
        "name": "Tako Network Engineering Team",
        "email": "noc@tako.id",
        "url": "https://tako.id"
    },
    "contributors": [
        {
            "name": "Rafly Maulana",
            "email": "rafly@tako.id",
            "url": "https://raflymaulana.com"
        }
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "bun": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./presets": {
            "types": "./dist/types/presets/index.d.ts",
            "bun": "./src/presets/index.ts",
            "default": "./dist/presets/index.js"
        }
    },
    "bin": {
        "circuit": "dist/cli/index.js"
    },
    "files": [
        "src",
        "dist",
        "templates",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": ">=20.12",
        "bun": ">=1.3.5"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "typecheck": "bunx tsc --noEmit",
        "test": "bun test",
        "build": "bun scripts/build.ts",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "docs:dev": "bun scripts/schema-reference.ts && vitepress dev docs",
        "docs:build": "bun scripts/schema-reference.ts && vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "release": "bun scripts/release.ts",
        "prepare": "husky || true",
        "prepack": "bun run build"
    },
    "dependencies": {
        "@types/ssh2": "^1.15.6",
        "jiti": "^2.7.0",
        "ssh2": "^1.17.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.5.0",
        "@commitlint/config-conventional": "^19.5.0",
        "@types/bun": "^1.4.2",
        "@types/node": "^24",
        "husky": "^9.1.6",
        "prettier": "^3.9.9",
        "typescript": "^7.0.2",
        "vitepress": "^1.6.4"
    },
    "packageManager": "bun@1.3.5"
}
